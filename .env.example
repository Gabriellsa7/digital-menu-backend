# HTTP server
PORT=3000
NODE_ENV=DEV

# MongoDB
DATABASE_URI="mongodb://whitebeard:whitebeard@localhost/whitebeard"
MONGODB_DATABASE='whitebeard'

# Auth
# Long random strings, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_STAFF_DAYS=7
REFRESH_TTL_CUSTOMER_DAYS=30
# Login attempts per IP every 15 minutes
AUTH_RATE_LIMIT_MAX=20
# First owner, created on boot when no owner exists
BOOTSTRAP_OWNER_NAME=Owner
BOOTSTRAP_OWNER_EMAIL=owner@digitalmenu.dev
BOOTSTRAP_OWNER_PASSWORD=change-me-123
# bcrypt cost for staff passwords
BCRYPT_ROUNDS=10
# Parent domain shared by the API and the front ends in production (optional)
COOKIE_DOMAIN=

# Customer login
OTP_PEPPER=change-me
# Returns the simulated SMS code in the response (demo only, OTP-R07)
OTP_EXPOSE_CODE=true
# Google Cloud Console > Credentials > OAuth client ID (Web)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Images (optional outside production; without them images stay in memory)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenTelemetry
# Set to 'true' to disable tracing entirely (it is disabled in tests via .env.test)
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=node-boilerplate
# OTLP HTTP endpoint of your collector (Jaeger, Grafana Tempo, etc.)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
